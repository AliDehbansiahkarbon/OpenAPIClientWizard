{
  "swagger": "2.0",
  "info": {
    "title": "Store API",
    "version": "1.0.0"
  },
  "host": "api.example.com",
  "basePath": "/v1",
  "schemes": ["https"],
  "paths": {
    "/orders/{orderId}": {
      "parameters": [
        {
          "name": "orderId",
          "in": "path",
          "required": true,
          "type": "integer",
          "description": "Order identifier."
        }
      ],
      "get": {
        "operationId": "getOrderById",
        "summary": "Get order by id",
        "responses": {
          "200": {
            "description": "Order found"
          }
        }
      },
      "delete": {
        "operationId": "deleteOrder",
        "summary": "Delete order",
        "responses": {
          "204": {
            "description": "Order deleted"
          }
        }
      }
    },
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "includeArchived",
            "in": "query",
            "required": false,
            "type": "boolean"
          }
        ],
        "responses": {
          "200": {
            "description": "Order list"
          }
        }
      },
      "post": {
        "operationId": "createOrder",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    }
  }
}
