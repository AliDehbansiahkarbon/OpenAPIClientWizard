{
  "id": "legacy-store-api",
  "name": "Legacy Store API Collection v1",
  "order": ["list-products", "get-product", "create-product"],
  "requests": [
    {
      "id": "list-products",
      "name": "List Products",
      "method": "GET",
      "url": "https://api.example.com/v1/products?search=demo&active=true"
